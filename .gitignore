.latex-build/

# LaTeX intermediates from the dedicated rebuttal build. Keep the source and
# finished PDF visible to Git.
comments/RAL/response/*.aux
comments/RAL/response/*.fdb_latexmk
comments/RAL/response/*.fls
comments/RAL/response/*.log
comments/RAL/response/*.out
comments/RAL/response/*.synctex.gz

# Current rebuttal sources, PDFs, and LaTeX build files are intentionally kept
# together. Ignore only the reproducible auxiliary files.
comments/RAL/second_rebutal/response/*.aux
comments/RAL/second_rebutal/response/*.fdb_latexmk
comments/RAL/second_rebutal/response/*.fls
comments/RAL/second_rebutal/response/*.log
comments/RAL/second_rebutal/response/*.out
comments/RAL/second_rebutal/response/*.synctex.gz
